# ------------------------------------------------------------------------------
# SOCIAL MEDIA THREAT INTELLIGENCE PIPELINE - CONFIGURATION TEMPLATE (.env)
# ------------------------------------------------------------------------------

# Database Settings (Uncomment to use PostgreSQL. Default is SQLite threat_intel.db)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres_secure_password
# POSTGRES_DB=threat_intel
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Redis Cache & Broker Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CELERY_DB=1

# API Credentials (Free Tier / Alternative Scrapers)
# YouTube API key is required to query YouTube Data API v3 (free 10,000 requests/day quota)
YOUTUBE_API_KEY=your_youtube_api_key_here

# X (Twitter) & Facebook RSS/Scraping configurations (API tokens not required for free mode)
# List keywords to scan separated by commas
TARGET_KEYWORDS=ntk, nam tamilar katchi, seeman, senthamizhan seeman, senthamizhan, naam thamizhar, seeman speech, seeman political speech, tn election, assembly elections, ntk seeman, seemanism, tamil nationalism, seeman meeting, seeman campaign, seeman supporter, seeman advocates, veera thamizhar peravai, ntk students wing, ntk womens wing, vyavasayi, sugarcane farmer ntk, seeman interview, seeman media, seeman press meet, seeman speech today, seeman debate, seeman latest speech, seeman latest interview, seeman vs dmk, seeman vs bjp, seeman vs tvk, seeman vs vijay, seeman vs stalin, seeman vs annamalai, seeman vs eps, seeman press conference, senthamizhan seeman arasiyal, ntk4tn, vote4ntk, seemanforchange, seemanofficial, cm seeman, seeman for cm, ntk cm candidate, thamizhar dhesiyam, tamil dhesiyam, tamil dhesiya arasiyal, ntk campaign, ntk meeting, tamil nadu politics, tn politics, tamil nadu election, tamil nadu assembly election, seeman nt, seemannk, nam tamilar seeman, seeman speech status, seeman debate, seeman press conference, seeman alliance, seeman vs eps, seeman vs stalin, seeman vs annamalai, seeman vs tvk, seeman vs dmk, seeman vs bjp, seeman vs congress, seeman vs pmk, seeman vs vck, seeman vs thirumavalavan, seeman vs udayanidhi stalin, seeman vs mk stalin, seeman vs edappadi palaniswami, seeman vs annamalai, seeman vs vijay tvk, seeman vs thalapathy vijay, seeman latest speech status, seeman speech in tamil, seeman political interview, seeman assembly constituency, veera thamizhar, ntk agricultural symbol, katchi symbol, vyavasayi symbol, seeman debate today, seeman vs dmk alliance, seeman vs bjp alliance, seeman vs tvk alliance, seeman political campaign today, seeman press meet today, ntk election candidate, seeman latest update, seeman election speech, seeman campaign speech, seeman election campaign, seeman public meeting, seeman public speech, seeman speech analysis, seeman campaign news
TELEGRAM_CHANNELS=naam_tamilar_katchi

# Free Alert Webhook URLs
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# App Settings
STREAMLIT_PORT=8501
CELERY_CONCURRENCY=1
LOG_LEVEL=INFO
USE_AI_CLASSIFIER=false
ALLOW_MOCK_DATA=false
MAX_POST_AGE_DAYS=3

